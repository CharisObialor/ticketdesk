# ---- App ----
NODE_ENV=production
APP_NAME=DateHeight Support
# Legal company name, shown in the portal and email footers.
COMPANY_NAME=DateHeight Integrated Nigeria Limited
# Public URL of the portal (used in email links). No trailing slash.
APP_URL=https://support.yourcompany.com
# Proxies in front of the app. cPanel's web server is one, so leave this at 1 there. Set 0 only if the app is
# reachable directly (no web server in front), otherwise visitors could fake their address to dodge rate limits.
TRUST_PROXY=1
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# The app refuses to start in production if JWT_SECRET is shorter than 32 characters or looks like a placeholder.
# PORT is set automatically by cPanel/Passenger. Only needed locally.
# PORT=3000

# ---- Database ----
# mysql (cPanel) or sqlite (local testing, needs Node 22.5+)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_ticketdesk
DB_PASSWORD=
DB_NAME=cpaneluser_ticketdesk
# SQLITE_PATH=./storage/ticketdesk.sqlite

# ---- First admin (created automatically on first start if no users exist) ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
# The only admin who can create, edit or invite other admin accounts.
OWNER_EMAIL=charis.obialor@dateheight.com

# ---- Email: Microsoft 365 (recommended when your mailboxes are on Microsoft) ----
# Sends and reads mail for one support mailbox through Microsoft Graph. Microsoft no longer allows
# password sign-in for SMTP/IMAP, so this uses an app registration instead. Setup steps are in README.md.
# When MS_CLIENT_ID is set, the SMTP and IMAP settings below are ignored.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=support@yourcompany.com
# Staff emails are sent from the staff member's own mailbox when their address is on these domains
# (default: the domain of MS_MAILBOX). Set MS_SEND_AS_STAFF=false to send everything from MS_MAILBOX.
# MS_SEND_AS_STAFF=true
# MS_SENDER_DOMAINS=yourcompany.com
# Shared mailboxes are found automatically from Exchange delegation (see README, step 9). Without that access,
# list them here: mailbox=who|who;mailbox2=*  (* = every admin with a company mailbox)
# MS_SHARED_MAILBOXES=info@yourcompany.com=admin1@yourcompany.com|admin2@yourcompany.com;systems@yourcompany.com=*
# A copy running on your own computer (APP_URL on localhost) does not send email or read the mailbox: emails are
# printed instead, so test tickets never reach real people. Set LOCAL_REAL_EMAIL=true to send for real from it.
# LOCAL_REAL_EMAIL=false
# Automatic emails (reminders, SLA alerts, digests, statements, account emails) come from this shared mailbox while
# MS_SYSTEM_DELEGATE (default: the owner) has Full Access to it; otherwise from MS_MAILBOX.
# MS_SYSTEM_MAILBOX=systems@yourcompany.com
# MS_SYSTEM_DELEGATE=owner@yourcompany.com
# Reply by email is on by default with Microsoft 365; set to false to turn it off.
# REPLY_BY_EMAIL=true
# Emails that are not replies to a notification (new requests, or replies with the reply address removed) are only
# accepted when the sender passes SPF/DKIM/DMARC. Microsoft 365 always records this, so leave it on.
# INBOUND_REQUIRE_VERIFIED_SENDER=true

# ---- Email (SMTP), for other mail hosts such as cPanel ----
# If SMTP_HOST is empty, emails are printed to the console instead of being sent.
SMTP_HOST=mail.yourcompany.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@yourcompany.com
SMTP_PASS=
# Sender name and address (with Microsoft 365 the address must be MS_MAILBOX)
MAIL_FROM="DateHeight Support <support@yourcompany.com>"
# Optional address for replies, e.g. a monitored support inbox.
# MAIL_REPLY_TO=support@yourcompany.com

# ---- Uploads ----
# Per file, and files per upload on forms (new tickets, visits). Keep these modest on shared hosting.
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=5
# Messages (group chats, admin chats, ticket replies) take any number of files, each up to UPLOAD_MAX_MB, up to
# this total per message.
MESSAGE_ATTACHMENTS_MAX_TOTAL_MB=200
# Photos on an engineer's work update: how many, and the total size per update (each photo up to UPLOAD_MAX_MB).
WORK_PHOTOS_MAX=40
WORK_PHOTOS_MAX_TOTAL_MB=200
# Attachments on emails sent from the Mail page: total per email, and number of files.
# Microsoft 365 rejects emails over 35 MB unless the mailbox limit is raised (see README, Microsoft 365 step 8).
MAIL_ATTACHMENT_MAX_MB=100
MAIL_ATTACHMENT_MAX_FILES=20
# STORAGE_DIR=./storage

# ---- SLA: minutes without a first staff response before a ticket auto-escalates ----
SLA_URGENT_MIN=60
SLA_HIGH_MIN=240
SLA_NORMAL_MIN=1440
SLA_LOW_MIN=2880

# ---- Reply by email over IMAP (only for non-Microsoft hosts) ----
# Let people answer notification emails to post on the ticket. The app checks this mailbox over IMAP
# (usually the same cPanel account as SMTP). Leave IMAP_HOST empty to turn it off.
# Replies go to plus-addresses such as support+t42u7-abc123@yourcompany.com, which cPanel delivers to support@.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER / IMAP_PASS default to SMTP_USER / SMTP_PASS
# INBOUND_ADDRESS=support@yourcompany.com
IMAP_POLL_SECONDS=60

# ---- Sessions ----
# Sign people out after this many minutes without activity (0 = never). A warning appears one minute before.
SESSION_IDLE_MINUTES=30

# ---- Automation ----
# Close resolved tickets after this many days without a reply (0 = off)
AUTO_CLOSE_DAYS=7
# Email group members about messages unread for this many minutes (0 = off)
CHAT_DIGEST_MINUTES=15
# Minutes after sending that people can edit a chat message, and delete it for everyone.
CHAT_EDIT_MINUTES=15
CHAT_DELETE_MINUTES=60
# Times in emails (site visits) use this time zone
APP_TIMEZONE=Africa/Lagos

# ---- Ticket assistant (admins only) ----
# Summaries, next steps, risks and drafted replies. Three engines:
#  - built-in (default): free, instant, no data leaves the server. Nothing to set.
#  - Ollama: free open-source AI on your own PC/server (16 GB+ RAM). Install from https://ollama.com,
#    run "ollama pull llama3.1:8b", then set OLLAMA_URL (e.g. http://192.168.1.20:11434).
#  - Claude: paid per use; set ANTHROPIC_API_KEY. Sends ticket text to Anthropic.
# If Ollama or Claude fails, the built-in assistant answers instead. AI_PROVIDER=builtin|ollama|claude forces one.
# AI_PROVIDER=
# OLLAMA_URL=
# OLLAMA_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ---- Admin actions and reminders ----
# Weekday summary email of outstanding actions, sent after this hour (APP_TIMEZONE).
ACTIONS_DAILY_HOUR=8
# Email admins immediately when an urgent action appears (true/false).
ACTIONS_URGENT_EMAILS=true

# ---- Backups ----
# Nightly backup runs after this hour (server time) and keeps this many copies in storage/backups
BACKUP_HOUR=2
BACKUP_KEEP=14
# Restore with: node scripts/restore-backup.js storage/backups/<file>.jsonl.gz
